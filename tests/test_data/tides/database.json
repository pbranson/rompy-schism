{
  "FES2014_test": {
    "format": "FES-netcdf",
    "name": "FES2014",
    "reference": "https://www.aviso.altimetry.fr/en/data/products/auxiliary-products/global-tide-fes.html",
    "version": "FES2014",
    "u": {
      "model_file": [
        "fes2014/eastward_velocity/m2.nc",
        "fes2014/eastward_velocity/s2.nc",
        "fes2014/eastward_velocity/n2.nc"
      ],
      "units": "cm/s",
      "variable": "zonal_tidal_current"
    },
    "v": {
      "model_file": [
        "fes2014/northward_velocity/m2.nc",
        "fes2014/northward_velocity/s2.nc",
        "fes2014/northward_velocity/n2.nc"
      ],
      "units": "cm/s",
      "variable": "meridional_tidal_current"
    },
    "z": {
      "model_file": [
        "fes2014/ocean_tide/m2.nc",
        "fes2014/ocean_tide/s2.nc",
        "fes2014/ocean_tide/n2.nc"
      ],
      "units": "cm",
      "variable": "tide_ocean"
    }
  },
  "OCEANUM-atlas": {
    "format": "ATLAS-netcdf",
    "name": "OCEANUM-atlas",
    "projection": "EPSG:4326",
    "reference": "https://oceanum.io",
    "version": "v2",
    "u": {
      "grid_file": "oceanum-atlas/grid_tpxo9_atlas_30_v2.nc",
      "model_file": [
        "oceanum-atlas/u_m2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/u_n2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/u_s2_tpxo9_atlas_30_v2.nc"
      ],
      "units": "cm^2/s",
      "variable": "zonal_tidal_current"
    },
    "v": {
      "grid_file": "oceanum-atlas/grid_tpxo9_atlas_30_v2.nc",
      "model_file": [
        "oceanum-atlas/u_m2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/u_n2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/u_s2_tpxo9_atlas_30_v2.nc"
      ],
      "units": "cm^2/s",
      "variable": "meridional_tidal_current"
    },
    "z": {
      "grid_file": "oceanum-atlas/grid_tpxo9_atlas_30_v2.nc",
      "model_file": [
        "oceanum-atlas/h_m2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/h_n2_tpxo9_atlas_30_v2.nc",
        "oceanum-atlas/h_s2_tpxo9_atlas_30_v2.nc"
      ],
      "units": "mm",
      "variable": "tide_ocean"
    }
  }
}
